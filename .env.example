# Copy to .env and fill in. Never commit .env.

# --- Database (Tiger Cloud Postgres with pgvector) ---
DATABASE_URL="postgresql://tsdbadmin:<password>@<host>.tsdb.cloud.timescale.com:<port>/tsdb?sslmode=require"

# --- Better Auth ---
BETTER_AUTH_SECRET=""              # openssl rand -hex 32
BETTER_AUTH_URL="http://localhost:3000"   # https://<domain> in production

# --- DigitalOcean Spaces ---
SPACES_KEY=""
SPACES_SECRET=""
SPACES_BUCKET=""
SPACES_REGION="us-east-1"          # the SDK's signing region; Spaces ignores it
SPACES_ENDPOINT="https://nyc3.digitaloceanspaces.com"

# --- Gemini ---
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"        # 2.5 models are retired for new keys; fallback: gemini-3.5-flash-lite
GEMINI_EMBED_MODEL="gemini-embedding-001"

# --- ElevenLabs ---
ELEVENLABS_API_KEY=""
ELEVENLABS_AGENT_ID=""               # created by `npm run agent:sync`; shared by the team

# --- WebRTC (coturn + self-hosted PeerJS) ---
# Local dev uses the production PeerJS + coturn servers, so TURN_SECRET must match
# the droplet's (ask William; it's not committed).
TURN_SECRET=""
TURN_HOST="hiremealready.study"
NEXT_PUBLIC_PEER_HOST="hiremealready.study"
NEXT_PUBLIC_PEER_PORT="443"
NEXT_PUBLIC_PEER_PATH="/peerjs"
